# The service worker file itself must never be served stale — browsers
# already re-check it on every navigation, but forcing no-cache here
# stops Cloudflare's edge (or any intermediate cache) from also holding
# on to an old copy and handing that back instead. This is what makes a
# SW_VERSION bump (see sw.js) actually take effect for real visitors
# right away, instead of only after their cached copy happens to expire.
/sw.js
  Cache-Control: no-cache

# --- Long cache lifetimes for static assets (PageSpeed fix #7) ---
#
# /css/* and /js/* are safe to cache for a full year + `immutable`: every
# reference to these files across every HTML page carries a `?v=YYYYMMDD`
# query string (see index.html etc. — e.g. `main.min.css?v=20260808`,
# `site-config.min.js?v=20260808`). Bump that date string (site-wide) the
# next time `npm run build` regenerates the .min.* files with real content
# changes, and every browser/edge cache instantly treats it as a brand-new
# URL — no waiting for the old cache entry to expire.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# /images/* is intentionally NOT `immutable` and capped at 30 days, not a
# year: these files (favicon/icons, hero-banner, logo-placeholder,
# animations) are NOT query-string versioned like css/js are, and this
# has already bitten the site once — the 2026-07-22 favicon/icon
# regeneration changed these exact file paths' *content* with no rename.
# A year-long immutable cache would have meant real visitors kept seeing
# the old favicon for up to a year. 30 days still satisfies Lighthouse's
# "efficient cache lifetimes" audit and meaningfully cuts repeat-visit
# image requests, without that stale-forever risk. If these ever get a
# proper `?v=` / content-hash versioning scheme added, this can safely
# move to the same 1-year immutable rule as css/js above.
/images/*
  Cache-Control: public, max-age=2592000
